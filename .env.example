# Copy to .env (never committed) and load with your process manager.
# Full list and defaults: README.md "配置".

DWM_ENV=production
DWM_DEFAULT_TENANT_ID=tenant-main
DWM_DEFAULT_API_KEY=replace-with-a-long-random-secret
DWM_STORAGE_ROOT=/srv/cleanplate/storage
DWM_RUNTIME_ROOT=/srv/cleanplate/runtime
DWM_COMFYUI_API_URL=http://127.0.0.1:8188
DWM_AUTO_START_COMFYUI=true

# Host-only: 环境里设了 HTTP_PROXY/HTTPS_PROXY 时必加，否则探测 127.0.0.1:8188 会走代理并误报 502
NO_PROXY=127.0.0.1,localhost

# Pipeline
DWM_DETECTOR_MODE=auto
DWM_QUALITY_MODE=balanced
DWM_CHUNK_FRAMES=81
DWM_NO_WATERMARK_POLICY=fail
DWM_QA_RESIDUAL_POLICY=flag
DWM_MAX_VIDEO_SECONDS=180
DWM_COMFYUI_PROMPT_TIMEOUT_SECONDS=1800

# Safety
DWM_AUTO_ALLOW_COPY_FALLBACK=false
DWM_ALLOW_PRIVATE_CALLBACK_URLS=false
DWM_FILE_RETENTION_DAYS=7
